# Copy to .env.local for local work. In production these live in Vercel.
# Nothing can be bought until this is "true".
TICKET_SALES_OPEN=false
# The selling Stripe account. Both keys from the SAME account.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Tickets sold outside this Stripe account (an earlier account, cash, guests).
SEATS_SOLD_ELSEWHERE=0
# Optional; defaults to https://unstoppable.events
NEXT_PUBLIC_SITE_URL=
